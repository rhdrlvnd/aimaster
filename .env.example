# Copy to .env.local and supply the issued key locally.
# Loaded by the Python backend only. Never expose the key to the browser.
LLM_API_KEY=
LLM_PROVIDER=azure_openai_compatible
LLM_BASE_URL=https://skax.ai-talentlab.com
LLM_API_VERSION=2024-12-01-preview
LLM_CHAT_MODEL=gpt-6.1-sol
LLM_EMBEDDING_MODEL=text-embedding-3-large

# Google OAuth web application (Calendar API enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5185/api/calendar/callback
